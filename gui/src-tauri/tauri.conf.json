{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "osu-shelf",
  "mainBinaryName": "osu-shelf-gui",
  "version": "0.4.0",
  "identifier": "io.github.desirethings.osu-shelf",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "osu-shelf",
        "width": 1100,
        "height": 740,
        "minWidth": 820,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data: https://assets.ppy.sh; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb"],
    "publisher": "DesireThings",
    "copyright": "Copyright (c) 2026 uwuclxdy, DesireThings",
    "homepage": "https://github.com/DesireThings/osu-shelf",
    "category": "Utility",
    "shortDescription": "Download osu!collector collections and import them into osu!",
    "longDescription": "Downloads beatmap collections from osu!collector through community mirrors and imports them, collections included, into osu!lazer or osu! stable. Unofficial; not made by ppy or osu!Collector.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": ["libssl3 | libssl3t64"]
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
